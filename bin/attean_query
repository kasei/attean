#!/usr/bin/env perl

=head1 NAME

attean_query - Query RDF data with SPARQL

=head1 DESCRIPTION

attean_query provides a command-line interface to the Attean module and its
SPARQL query functionality. It can load RDF data into in-memory storage,
parse a SPARQL query, and evaluate the query against the stored data,
serializing the results.

=head1 SYNOPSYS

  attean_query [OPTIONS] QUERYFILE.rq [data1.ttl data2.rdf ...]

=head1 OPTIONS

=over 4

=item * C<--algebra> C<-a>

Print the SPARQL algebra resulting from query parsing.

=item * C<--plan> C<-p>

Print the query plan which will be used for query evaluation.

=item * C<--simpleeval> C<-s> Use L<Attean::SimpleQueryEvaluator>

to evaluate the query, bypassing the default query-planner-based evaluation.

=item * C<-q>

Print a formatted version of the SPARQL query string.

=item * C<-c>

Check the syntax of the query.

=item * C<--short>

Use short blank-node identifiers in serialized results.

=item * C<--output FORMAT> C<-o FORMAT>

Results format. FORMAT may be one of the Attean serializer names (e.g. "SPARQLJSON") or a file extension (e.g. "srj").

=item * C<--update> C<-u>

Update mode.

=item * C<-n>

Dry-run.

=item * C<--verbose> C<-v>

Verbose mode. Print debugging messages about the query process.

=back

=cut

use v5.14;
use warnings;
no warnings 'once';
use autodie;
use File::Slurp;
use Scalar::Util qw(blessed);
use Attean;
use Attean::RDF;
use AtteanX::Functions::CompositeMaps;
use AtteanX::Functions::CompositeLists;
use Attean::SimpleQueryEvaluator;
use Data::Dumper;
use Getopt::Long;
use Try::Tiny;
use open ':std', ':encoding(utf8)';

BEGIN { $Error::TypeTiny::StackTrace	= 1; }

if (scalar(@ARGV) < 1) {
	print STDERR <<"END";
Usage: $0 query.rq [data.ttl ...]

Parses the supplied SPARQL query to an Attean::Algebra object,
and executes it against a model containing the RDF data parsed
from the data file(s) using Attean::SimpleQueryEvaluator.

END
	exit(0);
}

AtteanX::Functions::CompositeMaps->register();
AtteanX::Functions::CompositeLists->register();

my $dryrun				= 0;
my $check_syntax		= 0;
my $verbose				= 0;
my $debug				= 0;
my $benchmark			= 0;
my $print_sparql		= 0;
my $print_plan			= 0;
my $print_algebra		= 0;
my $update				= 0;
my $simple_eval			= 0;
my $out_format			= '';
my $store_config		= '';
my $short				= 0;
my $help				= 0;
my $version				= '1.2';
my $default_graph		= 'http://default-graph/';
my $result				= GetOptions(
	'algebra'			=> \$print_algebra,
	'c'					=> \$check_syntax,
	'default_graph=s'	=> \$default_graph,
	'n'					=> \$dryrun,
	'output=s'			=> \$out_format,
	'plan'				=> \$print_plan,
	'short'				=> \$short,
	'simpleeval'		=> \$simple_eval,
	'specVersion=s'		=> \$version,
	'store=s'			=> \$store_config,
	"benchmark"			=> \$benchmark,
	"debug"				=> \$debug,
	"help"				=> \$help,
	"q"					=> \$print_sparql,
	"update"			=> \$update,
	"verbose"			=> \$verbose,
);

if ($help) {
	print <<"END";
Usage: $0 [OPTIONS] query.rq [data.ttl ...]

OPTIONS:

  --help                  Display this usage information.
  --store=CONFIG          Specify the storage information (e.g. for using persistent RDF storage).
  --algebra               Display the parsed query algebra.
  --default_graph=IRI     Specify the IRI to use as the default graph.
  --plan                  Display the query plan structure.
  --simpleeval            Use Attean::SimpleQueryEvaluator to evaluate the query.
  --short                 Shorten blank node labels in the result serialization.
  --update                Allow SPARQL updates to be evaluated.
  --output=SERIALIZER     Specify the format to use for serializing results.
  --specVersion=VERSION   Specify the SPARQL version number to use (default=1.2).

END

	print "Stores:\n";
	foreach my $p (Attean->stores()) {
		$p	=~ s/^.*:://;
		print "  $p\n";
	}
	print "\n";

	print "Data Parsers:\n";
	foreach my $p (Attean->parsers()) {
		$p	=~ s/^.*:://;
		print "  $p\n";
	}
	print "\n";

	print "Serializers:\n";
	foreach my $p (Attean->serializers()) {
		$p	=~ s/^.*:://;
		print "  $p\n";
	}
	print "\n";
	exit(0);
}

my $qfile	= shift;

try {
	warn "Constructing model...\n" if ($verbose);
	my $store;
	my @datafiles;
	if ($store_config) {
		my ($name, $args, $files)	= Attean->parse_store_args($store_config);
		if (scalar(@$files)) {
			@datafiles	= @$files;
			if (scalar(@ARGV)) {
				die 'Cannot specify default RDF data in both the --store config and command line arguments';
			}
		}
		my $sclass	= Attean->get_store($name);
		unless ($sclass) {
			die "No '${sclass}' store found"
		}
		$store		= $sclass->new(%$args);
		
	} else {
		$store		= Attean->get_store('Memory')->new();
		@datafiles	= @ARGV;
	}

	my $model	= Attean::MutableQuadModel->new( store => $store );
	my $graph	= Attean::IRI->new($default_graph);
	my $map		= URI::NamespaceMap->new();
	while (my $data = shift(@datafiles)) {
		my $base	= Attean::IRI->new('file://' . File::Spec->rel2abs($data));
		open(my $fh, '<:encoding(UTF-8)', $data);
		warn "Parsing data from $data...\n" if ($verbose);
		my $pclass	= Attean->get_parser( filename => $data ) // 'AtteanX::Parser::Turtle';
		my $parser	= $pclass->new(base => $base, namespaces => $map);
		my $iter	= $parser->parse_iter_from_io($fh);
		my $quads	= $iter->as_quads($graph);
		$model->add_iter($quads);
	}
	
	if ($debug) {
		my $iter	= $model->get_quads();
		while (my $q = $iter->next) {
			say $q->as_string;
		}
	}

	warn "Parsing query...\n" if ($verbose);
	my $base	= Attean::IRI->new('file://' . File::Spec->rel2abs($qfile));
	my $s 		= Attean->get_parser('SPARQL')->new(base => $base, namespaces => $map, version => $version);
	if ($update) {
		$s->update(1);
	}
	open(my $fh, '<:utf8', $qfile) or die $!;
	my $algebra;
	eval {
		($algebra)	= $s->parse_list_from_io($fh);
	};
	if ($@) {
		if ($check_syntax) {
			print "Syntax NOT OK: $qfile\n";
			exit(1);
		} else {
			die "Failed to parse query $qfile: $@";
		}
	}

	if ($print_algebra) {
		print "# Algebra:\n" . $algebra->as_string . "\n";
	}
	
	if ($check_syntax) {
		print "Syntax OK: $qfile\n";
		exit(0);
	}
	
	if ($print_sparql) {
		print "# SPARQL:\n";
		print $algebra->as_sparql;
		print "\n";
	}
	
	if (not($dryrun) or $print_plan) {
		my $default_graphs	= [$graph];
		my $planner	= Attean::IDPQueryPlanner->new();
		my $plan	= $planner->plan_for_algebra($algebra, $model, $default_graphs);
		if ($print_plan) {
			print "# Plan:\n" . $plan->as_string . "\n";
		}
		unless ($dryrun) {
			my $mapper	= $short ? Attean::TermMap->short_blank_map : undef;
			my $bmapper	= $short ? $mapper->binding_mapper : undef;
			my $iter;
			if ($simple_eval) {
				my $e	= Attean::SimpleQueryEvaluator->new( model => $model, default_graph => $graph );
				$iter	= $e->evaluate($algebra, $graph)
			} else {
				$iter	= $plan->evaluate($model);
			}
			if ($bmapper) {
				$iter	= $iter->map($bmapper);
			}
			my $count	= 1;
			my $class	= Attean->get_serializer($out_format);
			if ($out_format and $class) {
				my $s	= $class->new(namespaces => $map);
				$s->serialize_iter_to_io(\*STDOUT, $iter);
			} else {
				while (my $r = $iter->next) {
					printf("%3d %s\n", $count++, $r->as_string);
				}
			}
		}
	}
} catch {
	my $exception	= $_;
	warn "Caught error: $exception";
	exit(1);
};
